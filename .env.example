# fal.ai MCP server credentials
# Copy this file to `.env` and fill in your real key, or export the variable
# in your shell before starting Claude Code. Never commit the real value.
#
# Format: <key-id>:<key-secret>  (this is the full token that follows "Bearer ")
FAL_MCP_KEY=your-fal-key-id:your-fal-key-secret
